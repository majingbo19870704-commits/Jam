{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "个人工作站 默认能力集：SQL / FS / Shell / Dialog / OS",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview",
    "core:webview:allow-webview-close",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-webview-hide",
    "core:webview:allow-webview-show",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-close",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "shell:default",
    "shell:allow-open",
    "dialog:default",
    "os:default"
    ,"notification:default"
  ]
}
