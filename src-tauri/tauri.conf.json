{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "个人工作站",
  "version": "0.1.0",
  "identifier": "com.majin.personal-workstation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "个人工作站",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": []
    },
    "shell": {
      "open": "(?:(?:https?|ftp)://.+|mailto:.+|tel:.+|[A-Za-z]:[\\\\/].+|\\\\\\\\[^\\\\/]+[\\\\/].+)"
    }
  }
}
